{
  "expo": {
    "name": "altokke_movil",
    "slug": "altokke-movil",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "altokkemovil",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/mototaxi-splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A130E"
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-apple-authentication",
      "expo-notifications",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "ios": {
      "bundleIdentifier": "pe.altokke.movil",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Altokke necesita acceso a tu ubicación mientras usas la app para mostrar conductores cercanos, calcular tarifas y guiar la ruta de tu viaje.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Altokke necesita acceso a tu ubicación en segundo plano para rastrear el progreso del viaje y garantizar tu seguridad durante el recorrido.",
        "NSCameraUsageDescription": "Altokke necesita acceso a la cámara para tomar fotos de tus documentos de identidad, brevete y SOAT para la verificación de conductor.",
        "NSPhotoLibraryUsageDescription": "Altokke necesita acceso a tu galería de fotos para subir imágenes de tus documentos y foto de perfil."
      }
    },
    "android": {
      "package": "pe.altokke.movil",
      "versionCode": 1,
      "allowBackup": false,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#0A130E"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "VIBRATE",
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "output": "static"
    },
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c8160c06-87ff-47e6-a092-6aca40801f0b"
      }
    },
    "owner": "altokke-team"
  }
}
