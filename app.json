{
  "expo": {
    "name": "altokke_movil",
    "slug": "altokke-movil",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "altokkemovil",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/mototaxi-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A130E"
    },
    "ios": {
      "bundleIdentifier": "pe.altokke.movil",
      "jsEngine": "hermes"
    },
    "android": {
      "package": "pe.altokke.movil",
      "versionCode": 1,
      "allowBackup": false,
      "usesCleartextTraffic": false,
      "jsEngine": "hermes",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#0A130E"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "VIBRATE"
      ]
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-splash-screen",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c8160c06-87ff-47e6-a092-6aca40801f0b"
      }
    },
    "owner": "altokke-team"
  }
}
