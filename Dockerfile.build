# ==============================================================================
# DOCKERFILE: ALTOKKE MOVIL - ENTORNO DE COMPILACIÓN ANDROID Y GOOGLE PLAY AAB
# ==============================================================================

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV ANDROID_HOME=/opt/android-sdk
ENV PATH=$PATH:$ANDROID_SDK_ROOT/cmdline-tools/latest/bin:$ANDROID_SDK_ROOT/platform-tools:$ANDROID_SDK_ROOT/build-tools/35.0.0
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

# 1. Dependencias del sistema y OpenJDK 17
RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-17-jdk \
    curl \
    git \
    unzip \
    zip \
    build-essential \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 2. Instalación de Node.js 20 LTS
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# 3. Android Command-line Tools y SDK 35 (Android 15 exigido por Google Play)
RUN mkdir -p $ANDROID_SDK_ROOT/cmdline-tools \
    && curl -o /tmp/cmdline-tools.zip https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip \
    && unzip /tmp/cmdline-tools.zip -d $ANDROID_SDK_ROOT/cmdline-tools \
    && mv $ANDROID_SDK_ROOT/cmdline-tools/cmdline-tools $ANDROID_SDK_ROOT/cmdline-tools/latest \
    && rm /tmp/cmdline-tools.zip

# Aceptación de licencias del SDK de Android
RUN yes | sdkmanager --licenses \
    && sdkmanager "platform-tools" "platforms;android-35" "build-tools;35.0.0" "ndk;26.1.10909125" "cmake;3.22.1"

# 4. Instalación global de EAS CLI (Expo local via npx)
RUN npm install -g eas-cli

WORKDIR /app

# Copia de manifiestos para caché de capas Docker
COPY package*.json ./
RUN npm ci --prefer-offline --no-audit

# Copia del código fuente del proyecto
COPY . .

# Comando por defecto: verificación de TypeScript y lint
CMD ["npx", "tsc", "--noEmit"]
